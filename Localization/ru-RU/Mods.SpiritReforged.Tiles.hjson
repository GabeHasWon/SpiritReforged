Records: {
	# Reforged pots
	CoinPortal:
		'''
		Всегда содержит портал с монетами.

		Удачная находка!
		'''
	Common:
		'''
		Обычный горшок, в котором иногда попадаются полезные предметы.

		Как правило, чем он глубже, тем дороже его содержимое.
		'''
	Zenith:
		'''
		Обычный горшок, в котором иногда попадаются полезные предметы... этот, к тому же, чересчур вычурный.

		Как правило, чем он глубже, тем дороже его содержимое.
		'''
	Potion: Содержит мощное зелье.
	UpsideDown: ‟Ошибка при производстве‟
	Worm: При разрушении из него выползают множество червей.
	Platter: Горячее блюдо, готовое к употреблению. Кто же мог его оставить?
	WickerBasket: Пикник — специально для вас!
	Aether: Даёт разнообразные полезные и сверкающие улучшения.
	Stuffed: Какое странное место для торговца. Похоже, он только и ждёт, чтобы его побеспокоили.
	Scrying: При разрушении открывает небольшую часть карты.
	Biome: Содержит больше разнообразной добычи, чем обычные горшки.
	Boulder: Покатится по земле, если его задеть.
	Wax: Полон могущественной магической энергии.

	# Spooky cross mod pots
	SpookyForest: {
		Name: Полная корзинка
		Entry: Передовое достижение в области хрупких переносок конфет.
	}

	SpiderGrotto: {
		Name: Кастрюля в паутине
		Entry: Кто это всё готовил?..
	}

	NoseTemple: {
		Name: Фарфоровый нос
		Entry: Роскошнейший фарфор для тех, кто любит задирать нос.
	}

	FetidFarms: {
		Name: Мешок с продуктами
		Entry: Сегодняшнего сбора!
	}

	RottenDepths: {
		Name: Фаршированный скелет
		Entry: Похоже, эта рыба что-то съела перед смерть.
	}

	TarPits: {
		Name: Смолямический горшок
		Entry: Узорчатый, чуток липкий, немного труснувший.
	}

	Krampus: {
		Name: Прекрасный подарок
		Entry: Крутейшая подарочная коробка, что вы когда либо видели.
	}

	UpperCatacombs: {
		Name: Древний резной горшок
		Entry: На нём прекрасный узор, хотя его и трудно разглядеть.
	}

	LowerCatacombs: {
		Name: Насмехающийся горшок
		Entry: Да, он насмехается именно над тобой.
	}
}

FablesGraves: {
	SetNames: {
		Savanna: Надгробия саванны
		SaltFlats: Солончаковые надгробья
	}
}

HydrothermalVent.MapEntry: Гидротермальное жерло
OreCarts.MapEntry: Вагонетка
PotionVats.MapEntry: Чан для зелий
ObsidianShroom.MapEntry: Обсидиановый гриб
Starflower.MapEntry: Звёздоцвет
BonsaiTrees.MapEntry: Бонсай
DustyTomb.MapEntry: Запылившийся гроб
