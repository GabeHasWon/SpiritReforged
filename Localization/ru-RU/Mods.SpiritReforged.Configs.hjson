ReforgedClientConfig: {
	DisplayName: Клиентская конфигурация

	ReflectionDetail: {
		Label: Детализация отражений
		Tooltip:
			'''
			Устанавливает уровень детализации отражений.
			Более высокие значения оказывают большую нагрузку на производительность.
			'''
	}

	AmbientSounds: {
		Label: Звуки окружения
		Tooltip: Добавляет новые звуки окружения в некоторые биомы.
	}

	ScreenshakeStrength: {
		Label: Множитель силы тряски экрана
		Tooltip: Устанавливает уровень силы тряски экрана, создаваемой контентом Reforged.
	}

	DisableWater: {
		Label: Отключить эффекты воды
		Tooltip: Отключает все визуальные эффекты воды, добавляемые Reforged.
	}

	DebugEcotones: {
		Label: Отладка экотонов в WorldGen Previewer
		Tooltip:
			'''
			ТОЛЬКО с модом WorldGen Previewer.
			Позволяет отлаживать проблемы с экотонами и лучше понимать их работу с помощью наглядного оверлея.
			'''
	}

	Headers.Developer: Для разработчиков

	GlyphProjectileVisualEffects: {
		Label: Эффекты снарядов зачарованного оружия
		Tooltip: Добавляет визуальные эффекты для снарядов оружия, на которое наложены глифы.
	}

	GlyphItemVisualEffects: {
		Label: Эффекты выброшенного зачарованного оружия
		Tooltip: Добавляет шейдеры и визуальные эффекты для выброшенного оружия, на которое наложены глифы.
	}

	BannerJingle: {
		Label: Уведомление о знамени
		Tooltip: Добавляет звуковой эффект звоночка, воспроизводящийся при получении первого знамени каждого существа.
	}
}

ReforgedServerConfig: {
	DisplayName: Серверная конфигурация

	VentCritters: {
		Label: Живность возле гидротермальных источников
		Tooltip:
			'''
			Рядом с гидротермальными источниками будут появляться различная живность.
			Она не влияет на частоту появления обычных врагов, но будет учитываться в общем лимите существ в мире.
			'''
	}

	MaxFloatingItemCount: {
		Label: Лимит плавающих предметов
		Tooltip: Ограничивает количество предметов, которые могут плавать на поверхности воды одновременно.
	}

	AutoloadHeldProjectiles: {
		Label: Автоматически определять удерживаемые снаряды
		Tooltip:
			'''
			Добавляет систему, автоматически определяющую снаряды, «удерживаемые» игроком, во время загрузки модов.
			Может значительно увеличить время загрузки или вызвать ошибки при загрузке других модов,
			но способна исправить определённые проблемы с некоторыми игровыми механиками (такими как глифы).
			Для обеспечения стабильной совместимости другие моды в идеале должны использовать именованный набор снарядов HeldProjectile (bool).

			Эта настройка не влияет на ванильные снаряды и снаряды Reforged, поскольку для них эта информация уже задана вручную.
			'''
	}
}
