			}
		}
	}
}

Enums: {
	OceanShape: {
		Default: {
			DisplayName: Vanilla
			Tooltip: Vanillas Standard-Ozeangenerierung. Dies deaktiviert die meisten Änderungen von Reforged.
		}

		SlantedSine: {
			DisplayName: Geneigte Sinuskurve
			Tooltip: Eine modifizierte Form, bei der der Ozean durch eine geneigte Sinuswelle definiert wird.
		}

		Piecewise: {
			DisplayName: Stückweise
			Tooltip: Eine komplexere stückweise Funktion definiert die Form des Ozeans.
		}

		Piecewise_M: {
			DisplayName: Stückweise (M)
			Tooltip: Eine modifizierte Version der stückweisen Funktion mit leicht unterschiedlichen Steigungen.
		}

		Piecewise_V: {
			DisplayName: Reforged
			Tooltip: Die finale Version der stückweisen Voreinstellung mit verschiedenen kleineren Änderungen.
		}
	}
}
