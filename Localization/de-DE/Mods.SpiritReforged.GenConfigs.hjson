UI: {
	Min: Alle Min
	MinDescription:
		'''
		Setzt alle Konfigurationen auf die Werte, die die Generierung am stärksten verringern würden.
		Ein Wert wie "maximale Bäume" würde also auf sein Minimum gesetzt,
		aber ein Wert für "Baumchance (1/x)" würde auf sein Maximum gesetzt.
		'''
	Max: Alle Max
	MaxDescription:
		'''
		Setzt alle Konfigurationen auf die Werte, die die Generierung am stärksten erhöhen würden.
		Ein Wert wie "maximale Bäume" würde also auf sein Maximum gesetzt,
		aber ein Wert für "Baumchance (1/x)" würde auf sein Minimum gesetzt.
		'''
	Preset: Voreinstellung:
	NoPresets: (Keine Voreinstellungen)
	None: Keine
	Reset: Zurücksetzen
	ResetAll: Alles zurücksetzen
	Prior: Vorherige:
	Next: Nächste:
	True: Aktiviert
	False: Deaktiviert
	Total: "{0} insgesamt"
	CustomPresetTooltip: Das ist eine benutzerdefinierte Voreinstellung!
	Create: Als benutzerdefinierte Voreinstellung speichern
	CantSave: (Du kannst keine Standardvoreinstellung speichern)
	Load: Eine benutzerdefinierte Voreinstellung laden
	LoadFolder: Einen Ordner voller Voreinstellungen laden
	HoverDescription: Öffnen, um bestimmte Aspekte der Generierung von Spirit Reforged zu konfigurieren.
	FailedToLoad: Voreinstellung passt nicht zu dieser Seite. Erwartete Seite: {0}
	ConfigNotice:
		'''
		[c/AAAAFF:Bereiche] funktionieren, indem sie ein Minimum und eine zufällige Ergänzung festlegen.
		Der angezeigte Wert ist der tatsächliche Bereich, der beim zufälligen Würfeln im Spiel verwendet wird.
		'''
	LoadError: Beim Laden einer Voreinstellung ist ein Fehler aufgetreten ({0}). Melde dies im Discord (und prüfe client.log):
	Duplicate: (Doppelte Voreinstellung(en) nicht hinzugefügt - {0})
	From: von
}

Pages: {
	Savanna: {
		Name: "{$Ecotones.SavannaEcotone}"
		Description: Steuert bestimmte Aspekte der Generierung des Savannen-Ökotons.

		Presets: {
			Domesticated: {
				Name: "[i:224] Domestiziert"
				Tooltip: Eine bewohntere Savanne mit mehr Töpfen und weniger Wildtieren.
			}

			Infested: {
				Name: "[i:SpiritReforged/TermiteJar] Befallen"
				Tooltip: Uups! Alles Termiten! Bäume könnten schwer zu finden sein.
			}

			Bumpy: {
				Name: "[i:SpiritReforged/Drypowder] Holprig"
				Tooltip: Pass auf, wo du hintrittst! Unebenheiten und Hügel erwarten dich in dieser wilden Savanne.
			}
		}

		Members: {
			OverSpawn: {
				DisplayName: "[i:50] Über dem Spawn"
				Tooltip: Ob die Savanne über dem Spawnpunkt erscheinen soll, ganz wie beim "Savanna"-Seed.
			}

			Steps: {
				DisplayName: "[i:SpiritReforged/DrywoodPlatformItem] Stufen"
				Tooltip: Die Anzahl flacher Stufen, mit denen die Savanne generiert wird.
			}

			CampsiteChance: {
				DisplayName: "[i:SpiritReforged/SavannaCampfireItem] Lagerplatz-Chance"
				Tooltip: Der Nenner (1/x) der Chance, dass ein Lagerplatz erscheint.
			}

			BaseTreeChance: {
				DisplayName: "[i:27] Akazienbaum-Chance"
				Tooltip:
					'''
					Der Nenner (1/x) der Chance, dass ein Baum auf einer bestimmten Kachel erscheint.
					Diese Chance erhöht sich, bis ein Baum platziert wird, und wird dann zurückgesetzt.
					'''
			}

			PotChance: {
				DisplayName: "[i:SpiritReforged/CommonPotsSavannaItem] Topf-Chance"
				Tooltip:
					'''
					Der Nenner (1/x) der Chance, dass beim Dekorieren ein Topf erscheint.
					Dies überschreibt keine vorhandenen Kacheln, ein Wert von eins wird also NICHT auf jeder Kachel einen Topf platzieren.
					'''
			}

			TermiteChance: {
				DisplayName: "[i:SpiritReforged/TermiteJar] Termiten-Chance"
				Tooltip: Der Nenner (1/x) der Chance, dass beim Dekorieren ein Termitenhügel erscheint.
			}
		}
	}

	SaltFlats: {
		Name: "{$Ecotones.SaltFlatsEcotone}"
		Description: Steuert bestimmte Aspekte der Generierung des Salzebenen-Ökotons.

		Presets: {
			SunkenRuin: {
				Name: "[i:SpiritReforged/CobbledBrickItem] Versunkene Ruinen"
				Tooltip: Die Ruinen einer uralten Zivilisation wurden abgeschliffen und ausgewaschen.
			}

			BlankCanvas: {
				Name: "[i:SpiritReforged/GlidingItem] Leere Leinwand"
				Tooltip: Eine leere, endlose Spiegelung liegt vor dir.
			}

			Dessicated: {
				Name: "[i:1274] Ausgetrocknet"
				Tooltip: Kein Tropfen Wasser ist zu sehen. Alle Bäume sind verdorrt.
			}
		}

		Members: {
			OverSpawn: {
				DisplayName: "[i:50] Über dem Spawn"
				Tooltip: Ob die Salzebene über dem Spawnpunkt erscheinen soll, ganz wie beim "salt"-Seed.
			}

			RuinQty: {
				DisplayName: "[i:SpiritReforged/CalmingBellItem] Salzebenen-Ruinen"
				Tooltip: Die Obergrenze der platzierten Salzebenen-Ruinen. Es werden möglicherweise nicht alle platziert.
			}

			LakeRadius: {
				DisplayName: "[i:206] Seeradius"
				Tooltip: Der Radius für Salzebenen-Seen. Größere Radien entsprechen größeren Seen.
			}

			CaveRadius: {
				DisplayName: "[i:SpiritReforged/SaltWallItem] Höhlenradius"
				Tooltip: Der Radius für Salzebenen-Höhlen. Größere Radien entsprechen größeren Höhlen.
			}

			MaxSteps: {
				DisplayName: "[i:SpiritReforged/SaltBlockReflectiveItem] Maximale Stufen"
				Tooltip: Die maximale Anzahl spiegelnder Salzebenen-Flächen innerhalb einer Salzebene.
			}

			StupaChance: {
				DisplayName: "[i:SpiritReforged/StoneStupasItem] Stupa-Chance"
				Tooltip:
					'''
					Der Nenner (1/x) der Chance, dass beim Dekorieren ein Stein-Stupa-Topf erscheint.
					Dies überschreibt keine vorhandenen Kacheln, ein Wert von 1 wird also NICHT auf jeder Kachel einen Topf platzieren.
					'''
			}

			TreeChance: {
				DisplayName: "[i:27] Totbaum-Chance"
				Tooltip:
					'''
					Der Nenner (1/x) der Chance, dass ein Baum auf einer bestimmten Kachel erscheint.
					Diese Chance erhöht sich, bis ein Baum platziert wird, und wird dann zurückgesetzt.
					'''
			}
		}
	}

	Surface: {
		Name: Oberfläche
		Description: Steuert bestimmte Aspekte von Reforgeds Ergänzungen und Änderungen an der Oberfläche.

		Presets: {
			Whimsical: {
				Name: "[i:SpiritReforged/MidnightApple] Skurril"
				Tooltip: Riesige, üppige Höhlen, Hügel voller wogendem Sterngras, ruhige Weizenfelder... was könnte da schon schiefgehen?
			}

			Treacherous: {
				Name: "[i:SpiritReforged/LeatherBackpack] Tückisch"
				Tooltip: Weite Schluchten können die Landschaft durchziehen. Schau nicht nach unten!
			}
		}

		Members: {
			HalfWidth: {
				DisplayName: "[i:133] (Schlucht) Halbe Breite"
				Tooltip: Steuert die halbe Breite des Hügels einer Schlucht, falls diese nahe genug an der Oberfläche liegt.
			}

			MaxDepth: {
				DisplayName: "[i:133] (Schlucht) Maximale Tiefe"
				Tooltip: Steuert die maximale Tiefe einer Schlucht.
			}

			SizeMultiplier: {
				DisplayName: "[i:747] (Karst) Größenmultiplikator"
				Tooltip: Multiplikator für die Größe aller Grabungen, die Karste (üppige Höhlen) durchführen.
			}

			FieldSize: {
				DisplayName: "[i:SpiritReforged/BotanistHat] (Weizenfeld) Feldgröße"
				Tooltip: Steuert die Breite des Weizenfelds einer Vogelscheuche.
			}

			ButterflyCountMax: {
				DisplayName: "[i:SpiritReforged/ButterflyStaff] (Schmetterlingsschreine) Maximum"
				Tooltip: Die maximale Anzahl an Schmetterlingsschreinen, die platziert werden können. Es werden möglicherweise nicht alle platziert.
			}

			HeroChance: {
				DisplayName: "[i:SpiritReforged/HerosMemorialStatueItem] (Gedenkstatue eines Helden) Spawn-Chance"
				Tooltip: Der Nenner (1/x) der Chance, dass die Gedenkstatue eines Helden erscheint.
			}

			MaxStargrassCount: {
				DisplayName: "[i:SpiritReforged/StarPowder] (Sterngras) Flächenanzahl"
				Tooltip: Die maximale Anzahl an Sterngras-Flächen, die platziert werden können. Es werden möglicherweise nicht alle platziert, oder sie können sich überlappen.
			}

			ReforgedCaveWeight: {
				DisplayName: "[i:30] (Höhlen) Benutzerdefinierte Gewichtung"
				Tooltip: Die Gewichtung dafür, dass eine benutzerdefinierte Reforged-Höhle anstelle einer normalen 'Berg'-Höhle erscheint.
			}
		}
	}

	Ocean: {
		Name: Ozean
		Description: Steuert bestimmte Aspekte von Reforgeds überarbeitetem Ozean.

		Presets: {
			KelpForest: {
				Name: "[i:SpiritReforged/Kelp] Seetangwald"
				Tooltip: Du kannst die Seetangfelder schon vom Ufer aus sehen!
			}

			Volcanic: {
				Name: "[i:SpiritReforged/GravelItem] Vulkanisch"
				Tooltip: Ein zerklüfteter, magmatischer Ozean mit kaum irgendeiner Flora.
			}
		}

		Members: {
			WaterChestCount: {
				DisplayName: "[i:1298] Maximale Wassertruhen"
				Tooltip: Die maximale Anzahl an Wassertruhen, die im Ozean platziert werden können. Meist werden nicht alle platziert.
			}

			SunkenTreasureCount: {
				DisplayName: "[i:SpiritReforged/SunkenTreasure] Maximaler Versunkener Schatz"
				Tooltip: Die maximale Anzahl an versunkenen Schätzen, die im Ozean platziert werden können. Meist werden nicht alle platziert.
			}

			SandDepth: {
				DisplayName: "[i:169] Sandtiefe"
				Tooltip: Wie weit der Sand unter dem Ozean in den Boden reicht.
			}

			SandRange: {
				DisplayName: "[i:169] Sandbereich"
				Tooltip: Die Obergrenze für den zufälligen zusätzlichen Bereich der Sandtiefe im Ozean.
			}

			CoralLowChance: {
				DisplayName: "[i:275] Korallenchance (Niedrig)"
				Tooltip: Der Nenner (1/x) dafür, dass Korallen in den unteren Stufen des Ozeans erscheinen.
			}

			CoralHighChance: {
				DisplayName: "[i:275] Korallenchance (Hoch)"
				Tooltip: Der Nenner (1/x) dafür, dass Korallen in der höchsten Stufe des Ozeans erscheinen.
			}

			DecorLowChance: {
				DisplayName: "[i:4090] Deko-Chance (Niedrig)"
				Tooltip: Der Nenner (1/x) dafür, dass Deko in den unteren Stufen des Ozeans erscheint.
			}

			DecorHighChance: {
				DisplayName: "[i:4090] Deko-Chance (Hoch)"
				Tooltip: Der Nenner (1/x) dafür, dass Deko in der höchsten Stufe des Ozeans erscheint.
			}

			KelpChance: {
				DisplayName: "[i:SpiritReforged/Kelp] Seetang-Chance"
				Tooltip: Der Nenner (1/x) dafür, dass Seetang im Ozean erscheint.
			}

			KelpMaxHeight: {
				DisplayName: "[i:SpiritReforged/Kelp] Seetang-Höhe"
				Tooltip: Die maximale Höhe in Kacheln, die Seetang erreichen kann.
			}

			GravelMultiplier: {
				DisplayName: "[i:SpiritReforged/GravelItem] Kies-Größenmultiplikator"
				Tooltip: Der Modifikator für die Größe von Ozean-Kies-Flächen (einschließlich Magmastein).
			}

			Shape: {
				DisplayName: "[i:4460] Ozeanform"
				Tooltip: Die Form, die der Ozean annimmt.
			}
		}
	}

