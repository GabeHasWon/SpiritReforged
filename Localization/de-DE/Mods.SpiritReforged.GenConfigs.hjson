	Ziggurat: {
		Name: Ziggurat
		Description: Steuert Aspekte der Ziggurat und ihrer Inhalte.

		Members: {
			UsedWidth: {
				DisplayName: "[i:SpiritReforged/RedSandstoneSlabItem] Breite"
				Tooltip:
					'''
					Die Breite, die zur Bestimmung der Größe der Ziggurat verwendet wird, nicht unbedingt die tatsächliche Breite.
					Höhere Werte als der Standard zwingen die Ziggurat dazu, über einer Pyramide zu erscheinen, da sie sonst möglicherweise gar nicht erscheint.
					'''
			}

			UsedHeight: {
				DisplayName: "[i:SpiritReforged/RedSandstoneSlabItem] Höhe"
				Tooltip:
					'''
					Die Höhe, die zur Bestimmung der Größe der Ziggurat verwendet wird, nicht unbedingt die tatsächliche Breite.
					Höhere Werte als der Standard zwingen die Ziggurat dazu, über einer Pyramide zu erscheinen, da sie sonst möglicherweise gar nicht erscheint.
					'''
			}

			MaxInfections: {
				DisplayName: "[i:SpiritReforged/PaleHiveItem] Maximale Befälle"
				Tooltip: Die Anzahl der Befälle (Nester) pro Stockwerk der Ziggurat. Reicht von 0 bis zu diesem Wert.
			}

			PotChance: {
				DisplayName: "[i:SpiritReforged/BronzePotsItem] Topf-Chance"
				Tooltip: Die Chance, dass Töpfe in der Ziggurat platziert werden.
			}

			LapisPotChance: {
				DisplayName: "[i:SpiritReforged/LapisPotsItem] Lapis-Topf-Chance"
				Tooltip: Die Chance, dass ein platzierter Topf ein Lapis-Topf ist.
			}

			UncommonChance: {
				DisplayName: "[i:SpiritReforged/BiomePotsDesertItem] Seltener-Topf-Chance"
				Tooltip: Die Chance, dass ein platzierter Topf ein Seltener Topf ist.
			}

			MaxSpikeStripWidth: {
				DisplayName: "[i:SpiritReforged/NeedleTrapItem] Maximale Stachelfallen-Breite"
				Tooltip: Die maximale Breite eines Stachelfallenstreifens.
			}

			SpikeStripChance: {
				DisplayName: "[i:SpiritReforged/NeedleTrapItem] Stachelfallen-Chance"
				Tooltip: Die Chance, dass in nicht-speziellen Räumen ein Stachelfallenstreifen platziert wird.
			}

			SpecialRoomChance: {
				DisplayName: "[i:SpiritReforged/CarvedLapisWallItem] Spezialraum-Chance"
				Tooltip:
					'''
					Die Chance, dass ein beliebiger Ziggurat-Raum ein Spezialraum ist; das heißt, einer von diesen:
					Bibliotheksraum, Lagerraum, Grabraum
					'''
