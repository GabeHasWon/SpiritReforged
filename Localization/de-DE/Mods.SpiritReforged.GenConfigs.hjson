			}

			RuinSegments: {
				DisplayName: "[i:SpiritReforged/RedSandstoneSlabItem] (Ruinen) Segmentbereich"
				Tooltip: Der Bereich dafür, wie viele Segmente eine unterirdische Ruine haben kann.
			}
		}

		Presets: {
			Overgrown: {
				Name: "[i:2996] Überwuchert"
