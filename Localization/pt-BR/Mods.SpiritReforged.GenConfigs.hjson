	Desert: {
		Name: Deserto
		Description: Controla várias aspectos da geração do deserto do Reforged

		Members: {
			PalmChanceLow: {
				DisplayName: "[i:2504] (Oásis) Chance de Palmeira (Baixa)"
				Tooltip: Chance de uma palmeira ser colocada após pelo menos uma já ter sido colocada.
			}

			PalmChanceHigh: {
				DisplayName: "[i:2504] (Oásis) Chance de Palmeira (Alta)"
				Tooltip: Chance de uma palmeira ser colocada após pelo menos uma já ter sido colocada.
			}

			CattailChance: {
				DisplayName: "[i:2996] (Oásis) Chance de Tifa"
				Tooltip: Chance de uma Tifa ser posicionada.
			}

			OasisPlantChance: {
				DisplayName: "[i:SpiritReforged/PineappleSeeds] (Oásis) Chance de Planta de Oásis"
				Tooltip: Chance de uma planta de Oásis ser colocada.
			}

			GlowflowerChance: {
				DisplayName: "[i:4045] (Oásis) Chance de Calêndula Solar"
				Tooltip: Chance de uma Calêndura Solar ser posicionada.
			}

			PineappleChance: {
				DisplayName: "[i:4294] (Oásis) Chance de Abacaxi"
				Tooltip: Chance de um Abacaxi ser posicionado.
			}

			SeaOatsChance: {
				DisplayName: "[i:SpiritReforged/WheatgrassSeedPouch] (Oásis) Chance de Aveias do Mar"
				Tooltip: Chance de posicionar Aveias do Mar. Aveias do Mar são as plantas graminiformes que crescem perto do oceano ou de oásis.
			}

			PoolWidth: {
				DisplayName: "[i:206] (Oásis) Largura do Lago"
				Tooltip: O alcance de largura que um lago subterrâneo de Oásis pode ter (em blocos).
			}

			PoolDepth: {
				DisplayName: "[i:206] (Oásis) Profundidade do Lago"
				Tooltip: O alcance de profundididade que um lago subterrâneo de Oásis pode ter (em blocos).
			}

			MainNormalization: {
				DisplayName: "[i:1298] (Oásis) Normalização de Tesouros Principais"
				Tooltip:
					'''
					O fator pelo qual os tesouros principais é normalizado.
					Quanto maior esse valor, mais "equilibrada" é a chance de obtenção de todos os itens.
					'''
			}

			ItemNormalization: {
				DisplayName: "[i:1298] (Oásis) Normalização de Tesouros Secundários"
				Tooltip:
					'''
					O fator pelo qual os tesouros não principais é normalizado.
					Quanto maior esse valor, mais "equilibrada" é a chance de obter qualquer um dos itens.
					'''
			}

			FossilCount: {
				DisplayName: "[i:SpiritReforged/PolishedAmberItem] (Âmbar) Quantidade no Mundo"
				Tooltip: O número máximo de veios de âmbar no Deserto Subterrâneo.
			}

			FossilMultiplier: {
				DisplayName: "[i:SpiritReforged/AmberFossilSafeItem] (Âmbar) Multiplicador por Escala do Mundo"
				Tooltip: O multiplicador aplicado ao número de veios de âmbar com base no tamanho do mundo.
			}

			PatchScale: {
				DisplayName: "[i:SpiritReforged/AmberFossilSafeItem] (Âmbar) Faixa de Tamanho dos Veios"
				Tooltip: A escala aplicada ao tamanho de um veio de âmbar.
			}

			RuinCount: {
				DisplayName: "[i:SpiritReforged/GildedRedSandstoneItem] (Ruinas) Faixa de Criação"
				Tooltip: A faixa de variação da quantidade de ruínas subterrâneas do deserto que surgem por oásis.
			}

			LightRange: {
				DisplayName: "[i:SpiritReforged/SunDropper] (Oásis) Contagem de Raios de Luz"
				Tooltip: O intervalo mínimo e o adicional aleatório para a quantidade de raios de luz em um oásis subterrâneo.
			}

			ChestItemRange: {
				DisplayName: "[i:1298] (Oásis) Faixa de Itens nos Baús"
				Tooltip: A faixa de quantidade de itens em um baú de Oásis subterrâneo.
			}

			RuinSegments: {
				DisplayName: "[i:SpiritReforged/RedSandstoneSlabItem] (Ruinas) Tamanho dos Seguimentos"
				Tooltip: A faixa de variação para o número de segmentos que uma ruína subterrânea pode ter.
			}
		}

		Presets: {
			Overgrown: {
				Name: "[i:2996] Coberto de Vegetação"
				Tooltip: Os oásis neste deserto são densamente povoados por vegetação e têm um aspecto selvagem. Como eles florescem?
			}

			Petrified: {
				Name: "[i:154] Petrificado"
				Tooltip: As areias deste deserto escondem vestígeos de ecossistemas que foram fossilizados. Será que você irá achar eles?
			}

			Ruined: {
				Name: "[i:SpiritReforged/RedSandstoneSlabItem] Arruinado"
				Tooltip: Uma antiga e esquecida civilização que viveu neste deserto...
			}
		}
	}
}

Enums: {
	OceanShape: {
		Default: {
			DisplayName: Vanilla
			Tooltip: Geração padrão do oceano do Vanilla, desativa diversas mudanças do Reforged.
		}

		SlantedSine: {
			DisplayName: Slanted Sine
			Tooltip: Uma forma modificada em que o oceano é definido por uma onda senoidal inclinada.
		}

		Piecewise: {
			DisplayName: Piecewise
			Tooltip: Uma função definida por partes mais complexa descreve o formato do oceano.
		}

		Piecewise_M: {
			DisplayName: Piecewise (M)
			Tooltip: Uma versão modificada da função definida por partes, com inclinações ligeiramente diferentes.
		}

		Piecewise_V: {
			DisplayName: Reforged
			Tooltip: A versão finalizada dos prefixos Piecewise com pequenas mudanças
		}
	}
}
