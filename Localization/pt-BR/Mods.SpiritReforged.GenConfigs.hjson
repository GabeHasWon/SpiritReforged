			}

			PicnicScale: {
				DisplayName: "[i:SpiritReforged/WickerBasketsItem] Escala de Cesta de Vime"
				Tooltip: O multiplicador do número de tentativas por Cesta de Vime.
			}

			StackScale: {
				DisplayName: "[i:SpiritReforged/PotsCavernItem] Escala de Empilhamento"
				Tooltip: O multiplicador do número de tentativas por Vasos Empilhados.
			}

			UncommonScale: {
				DisplayName: "[i:SpiritReforged/BiomePotsGraniteItem] Escala Incomum"
				Tooltip: O multiplicador do número de tentativas por todos os Vasos Incomuns.
			}

			ZenithScale: {
				DisplayName: "[i:SpiritReforged/ZenithPotsItem] Escala de Vaso Zênite"
				Tooltip: O multiplicador do número de tentativas pelo Vaso Zênite de um mundo Zênite.
			}

			WaxScale: {
				DisplayName: "[i:SpiritReforged/WaxPotItem] Escala de Vaso de Cera"
				Tooltip: O multiplicador do número de tentativas por Vasos de Cera.
			}
		}

		Presets: {
			Tasty: {
				Name: "[i:4029] Gostosuras"
				Tooltip: Alguém deixou uma quantidade simplesmente absurda de comida por aí. Quem será que fez tudo isso?
			}

			Occult: {
				Name: "[i:SpiritReforged/ScryingPotItem] Oculto"
				Tooltip: Os experimentos falhos de incontáveis feiticeiros espalhados pelas cavernas.
			}
		}
	}

	Caves: {
		Name: Cavernas
		Description: Controla adições diversas às Cavernas.

		Members: {
			SignChance: {
				DisplayName: "[i:171] (Casinhas) Chance de Placas"
				Tooltip: O denominador (1/x) da probabilidade de uma placa surgir em uma casinha subterrânea.
			}

			MannequinChance: {
				DisplayName: "[i:498] (Casinhas) Chance de Manequim"
				Tooltip: O denominador (1/x) da probabilidade de um manequim surgir em uma casinha subterrânea.
			}

			LoomChance: {
				DisplayName: "[i:332] (Casinhas) Chance de Tear"
				Tooltip: O denominador (1/x) da probabilidade de uma casinha ser uma "casa de tear" — que inclui estandartes e um tear.
			}

			RareSignChance: {
				DisplayName: "[i:3617] (Casinhas) Chance de Placas Raras"
				Tooltip: O denominador (1/x) da probabilidade de uma placa subterrânea exibir uma mensagem rara.
			}

			CartSpawnRate: {
				DisplayName: "[i:13] (Decor) Frequência de Carrinhos de Mina"
				Tooltip: O multiplicador da quantidade máxima de Carrinhos de Mina que aparecem em um mundo.
			}

			BoomshroomRate: {
				DisplayName: "[i:SpiritReforged/BoomShroom] (Decor) Frequência de Cogumelo"
				Tooltip: O multiplicador da quantidade máxima de Explodumelos que surgem em um mundo.
			}

			CovesSpawnRate: {
				DisplayName: "[i:SpiritReforged/KoiTotem] (Covas) Multiplicador"
				Tooltip:
					'''
					O multiplicador para a quantidade máxima de Covas de Pesca que surgem em um mundo.
					Isso pode causar problemas com outros mods que geram estruturas.
					'''
			}

			NeonMossChance: {
				DisplayName: "[i:SpiritReforged/FlaskRadon] (Musgo Brilhante) Chance de Musgo Customizado"
				Tooltip: A probabilidade de um musgo brilhante personalizado do Reforged ser escolhido em vez de um do jogo original (x/6).
			}

			StatueCountModifier: {
				DisplayName: "[i:SpiritReforged/WheezerStatueItem] (Estátuas) Máximo"
				Tooltip: A quantidade máxima de estátuas do Reforged geradas no mundo.
			}

			StructuresMax: {
				DisplayName: "[i:SpiritReforged/PotteryWheelItem] (Armazém) Multiplicador"
				Tooltip: O multiplicador para o número de estruturas Cerâmica em um mundo.
			}

			StructureScale: {
				DisplayName: "[i:SpiritReforged/PotteryWheelItem] (Armazém) Escala"
				Tooltip: A escala aplicada ao tamanho das estruturas de Cerâmica.
			}

			PotSpam: {
				DisplayName: "[i:SpiritReforged/PotteryWheelItem] (Armazém) Contador Vasos"
				Tooltip: O número mínimo de tentativas que as estruturas Vasotery precisam realizar para posicionar Vasos.
			}

			EnchantedWorkbenchChance: {
				DisplayName: "[i:SpiritReforged/EnchantedWorkbenchItem] (Casinhas) Chance de Mesa"
				Tooltip: O denominador (1/x) da probabilidade de uma Mesa Encantada surgir em uma casa subterrânea.
			}

			DisplayCaseChance: {
				DisplayName: "[i:SpiritReforged/DisplayCaseItem] (Casinhas) Chance de Obter Vitrine"
				Tooltip: O denominador (1/x) da probabilidade de uma Vitrine surgir em uma casinha subterrânea.
			}

			MirrorRate: {
				DisplayName: "[i:SpiritReforged/EnchantedMirrorItem] (Decor) Frequência de Espelhos"
				Tooltip: O multiplicador para a quantidade máxima de Espelhos de Retorno que surgem em um mundo.
			}
		}

		Presets: {
			Inhabited: {
				Name: "[i:498] Não Habitado"
				Tooltip: Há sinais de exploradores amigáveis ​​por todo o Subterrâneo... o que aconteceu com eles?
			}

			Empty: {
				Name: "[i:1176] Vazio"
				Tooltip: Tem alguém aí?
			}
		}
	}

	Ziggurat: {
		Name: Zigurate
		Description: Controla aspectos do Zigurate e de seu conteúdo.

		Members: {
			UsedWidth: {
				DisplayName: "[i:SpiritReforged/RedSandstoneSlabItem] Largura"
				Tooltip:
					'''
					A largura usada para determinar o tamanho do Zigurate, não necessariamente a largura real.
					Valores acima do padrão forçarão o Zigurate a surgir sobre uma Pirâmide, pois, caso contrário, ele pode acabar não surgindo.
					'''
			}

			UsedHeight: {
				DisplayName: "[i:SpiritReforged/RedSandstoneSlabItem] Altura"
				Tooltip:
					'''
					A altura usada para determinar o tamanho do Zigurate, não necessariamente a altura real.
					Valores acima do padrão forçarão o Zigurate a surgir sobre uma Pirâmide, pois, caso contrário, ele poderá não surgir de forma alguma.
					'''
			}

			MaxInfections: {
				DisplayName: "[i:SpiritReforged/PaleHiveItem] Máximo de Infestações"
				Tooltip: A quantidade de infestações (ninhos) por andar do Zigurate. Varia de 0 até este valor.
			}

			PotChance: {
				DisplayName: "[i:SpiritReforged/BronzePotsItem] Chance de Vaso"
				Tooltip: Chance de vasos serem colocados no Zigurate.
			}

			LapisPotChance: {
				DisplayName: "[i:SpiritReforged/LapisPotsItem] Chance de Vaso Lápis Lazuli"
				Tooltip: Chance de um Vaso colocado ser um Vaso de Lápis Lazuli.
			}

			UncommonChance: {
				DisplayName: "[i:SpiritReforged/BiomePotsDesertItem] Uncommon Vaso Chance"
				Tooltip: Chance for a Vaso placed to be an Uncommon Vaso.
			}

			MaxSpikeStripWidth: {
				DisplayName: "[i:SpiritReforged/NeedleTrapItem] Largura Máxima de Armadilha de Espinho"
				Tooltip: Define a largura máxima de uma armadilha deste tipo.
			}

			SpikeStripChance: {
				DisplayName: "[i:SpiritReforged/NeedleTrapItem] Chance de Armadilha de Espinho"
				Tooltip: A chance de aparecer uma armadilha deste tipo em salas não especiais.
			}

			SpecialRoomChance: {
				DisplayName: "[i:SpiritReforged/CarvedLapisWallItem] Chance de Sala Especial"
				Tooltip:
					'''
					A probabilidade de qualquer sala do Zigurate ser uma sala especial; isto é, qualquer uma destas:
					Sala de biblioteca, sala de armazenamento, sala de sepultamento
					'''
			}

			SkipRoomChance: {
				DisplayName: "[i:SpiritReforged/RedSandstoneBrickCrackedWallItem] Chance de Pular Sala"
				Tooltip: A chance de qualquer sala ser pulada ao invés de gerada.
			}

			ChestNormalization: {
				DisplayName: "[i:SpiritReforged/LapisChestItem] Normalização de Baú"
				Tooltip:
					'''
					O fator pelo qual o conjunto de itens do baú é normalizado.
					Quanto maior esse valor, mais "equilibrada" é a chance de obtenção de todos os itens.
					'''
			}

			DresserNormalization: {
				DisplayName: "[i:SpiritReforged/LapisDresserItem] Normalização de Cômoda"
				Tooltip:
					'''
					O fator pelo qual o conjunto de itens da cômoda é normalizado.
					Quanto maior esse valor, mais "equilibrada" é a probabilidade de obtenção de cada item.
					'''
