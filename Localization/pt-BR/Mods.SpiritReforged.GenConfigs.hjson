			}

			UpsideDownScale: {
				DisplayName: "[i:SpiritReforged/UpsideDownPotItem] Escala de Vaso de Cabeça pra Baixo"
				Tooltip: O multiplicador do número de tentativas por Vasos de Cabeça pra Baixo.
			}

			BoulderScale: {
				DisplayName: "[i:SpiritReforged/RollingPotsItem] Escala de Vaso Rolantes"
