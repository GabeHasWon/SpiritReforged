UI: {
	Min: Tudo do Mínimo
	MinDescription:
		'''
		Define todas as configurações com os valores que mais reduziriam a geração.
		Assim, um valor como "máximo de árvores" seria definido no seu mínimo,
		mas um valor para "chance de árvore (1/x)" seria definido no seu máximo.
		'''
	Max: Tudo no Máxima
	MaxDescription:
		'''
		Define todas as configurações com os valores que maximizariam a geração.
		Assim, um parâmetro como "número máximo de árvores" seria definido em seu valor máximo,
		enquanto um parâmetro como "probabilidade de árvore (1/x)" seria definido em seu valor mínimo.
		'''
	Preset: Predefinição:
	NoPresets: (Sem Predefinições)
	None: Nenhum
	Reset: Reiniciar
	ResetAll: Reiniciar Tudo
	Prior: Último:
	Next: Próximo:
	True: Ativado
	False: Desativado
	Total: "{0} total"
	CustomPresetTooltip: Está predefinição é customizada!
	Create: Salvar como predefinição customizada.
	CantSave: (Não é possível salvar uma predefinição padrão)
	Load: Carregar uma predefinição customizada.
	LoadFolder: Carregue uma pasta de predefinições
	HoverDescription: Abra para configurar aspectos específicos da geração do Spirit Reforged.
	FailedToLoad: A predefinição selecionada não é para esta página. Página esperada: {0}
	ConfigNotice:
		'''
		[c/AAAAFF:Alcances] funcionam definindo o valor mínimo e um acréscimo aleatório.
		O valor exibido é o intervalo real utilizado no jogo ao realizar uma rolagem aleatória.
		'''
	LoadError: Ocorreu um erro ao carregar uma predefinição ({0}). Relate isso no Discord (e verifique o client.log):
	Duplicate: (Predefinição duplicada não adicionada)
	From: de
}

Pages: {
	Savanna: {
		Name: "{$Ecotones.SavannaEcotone}"
		Description: Controla aspectos específicos da formação do ecótono da Savana.

		Presets: {
			Domesticated: {
				Name: "[i:224] Domesticado"
				Tooltip: Uma Savana com mais sinais de ocupação humana, mais vasos e menos vida selvagem.
			}

			Infested: {
				Name: "[i:SpiritReforged/TermiteJar] Infestação"
				Tooltip: Ops! Só cupins! Pode ser difícil encontrar árvores.
			}

			Bumpy: {
				Name: "[i:SpiritReforged/Drypowder] Protuberância"
				Tooltip: Cuidado onde pisa! Solavancos e elevações aguardam você nesta Savana selvagem.
			}
		}

		Members: {
			OverSpawn: {
				DisplayName: "[i:50] Sobre o Ponto de Surgimento"
				Tooltip: Se a savana deve surgir no ponto de nascimento, assim como na seed "savanna".
			}

			Steps: {
				DisplayName: "[i:SpiritReforged/DrywoodPlatformItem] Degraus"
				Tooltip: O número de degraus planos que a Savana gera.
			}

			CampsiteChance: {
				DisplayName: "[i:SpiritReforged/SavannaCampfireItem] Chance de Fogueira"
				Tooltip: O denominador (1/x) da probabilidade de surgimento de fogueiras.
			}

			BaseTreeChance: {
				DisplayName: "[i:27] Chance de Árvore de Acácia"
				Tooltip:
					'''
					O denominador (1/x) da probabilidade de uma árvore surgir em um determinado bloco.
					Essa chance aumenta até que uma árvore seja colocada e, então, é reiniciada.
					'''
			}

			PotChance: {
				DisplayName: "[i:SpiritReforged/CommonPotsSavannaItem] Chance de Vaso"
				Tooltip:
					'''
					O denominador (1/x) da probabilidade de um vaso surgir ao decorar.
					Isso não substitui os peças existentes; portanto, um valor de 1 NÃO colocará um Vaso em cada bloco.
					'''
			}

			TermiteChance: {
				DisplayName: "[i:SpiritReforged/TermiteJar] Chance de Cupins"
				Tooltip: O denominador (1/x) da probabilidade de um cupinzeiro surgir na geração.
			}
		}
	}

	SaltFlats: {
		Name: "{$Ecotones.SaltFlatsEcotone}"
		Description: Controla aspectos específicos da formação do ecótono das Salinas.

		Presets: {
			SunkenRuin: {
				Name: "[i:SpiritReforged/CobbledBrickItem] Ruínas Submersas"
				Tooltip: As ruínas de uma civilização antiga foram desgastadas pela ação da água e sofreram erosões.
			}

			BlankCanvas: {
				Name: "[i:SpiritReforged/GlidingItem] Quadro em Branco"
				Tooltip: Um reflexo vazio e infinito estende-se diante de você.
			}

			Dessicated: {
				Name: "[i:1274] Desidratado"
				Tooltip: Não se vê nem uma gota de água. Todas as árvores secaram.
			}
		}

		Members: {
			OverSpawn: {
				DisplayName: "[i:50] Sobre o Ponto de Surgimento"
				Tooltip: Se as Salinas deveriam surgir sobre o ponto de surgimento inicial, assim como na semente "salt".
			}

			RuinQty: {
				DisplayName: "[i:SpiritReforged/CalmingBellItem]Ruínas das Salinas"
				Tooltip: Mesmo com o limite superior de ruínas das Salinas foi definido. Nem todas podem ser posicionadas.
			}

			LakeRadius: {
				DisplayName: "[i:206] Raio dos Lagos"
				Tooltip: O raio para os lagos das Salinas. Raios maiores correspondem a lagos maiores.
			}

			CaveRadius: {
				DisplayName: "[i:SpiritReforged/SaltWallItem] Raio das Cavernas"
				Tooltip: O raio para as cavernas das Salinas. Raios maiores correspondem a cavernas maiores.
			}

			MaxSteps: {
				DisplayName: "[i:SpiritReforged/SaltBlockReflectiveItem] Planícies Maiores"
				Tooltip: O número máximo de planícies refletoras de sal dentro das Salinas.
			}

			StupaChance: {
				DisplayName: "[i:SpiritReforged/StoneStupasItem] Chance de Estupa"
				Tooltip:
					'''
					O denominador (1/x) da probabilidade de surgir um vaso (Estupa de Pedra) na geração.
					Isso não substitui peças existentes; portanto, um valor de 1 NÃO colocará um vaso em todos os blocos.
					'''
			}

			TreeChance: {
				DisplayName: "[i:27] Chance de Árvore Morta"
				Tooltip:
					'''
					O denominador (1/x) da probabilidade de uma árvore surgir em um determinado bloco.
					Essa probabilidade aumenta até que uma árvore seja colocada e, então, é reiniciada.
					'''
			}
		}
	}

	Surface: {
		Name: Surface
		Description: Controls specific aspects of Reforged's additions and edits to the surface.

		Presets: {
			Whimsical: {
				Name: "[i:SpiritReforged/MidnightApple] Caprichoso"
				Tooltip: Enormes cavernas exuberantes, colinas de grama estelar ondulante, trigais tranquilos... o que poderia dar errado?
			}

			Treacherous: {
				Name: "[i:SpiritReforged/LeatherBackpack] Traiçoeiro"
				Tooltip: Desfiladeiros imensos podem pontilhar a paisagem. Não olhe para baixo!
			}
		}

		Members: {
			HalfWidth: {
				DisplayName: "[i:133] (Cânion) Meia Largura"
				Tooltip: Controla a semilargura da elevação de um cânion, caso esta esteja suficientemente próxima da superfície.
			}

			MaxDepth: {
				DisplayName: "[i:133] (Cânion) Profundidade Máxima"
				Tooltip: Controla a profundidade máxima de um cânion.
			}

			SizeMultiplier: {
				DisplayName: "[i:747] (Carste) Multiplicador de Tamanho"
				Tooltip: O multiplicador para a escala de todas as operações de escavação realizadas por carstes (cavernas exuberantes).
			}

			FieldSize: {
				DisplayName: "[i:SpiritReforged/BotanistHat] (Campo de trigo) Tamanho do Campo"
				Tooltip: Controla a largura do campo de trigo de um espantalho.
			}

			ButterflyCountMax: {
				DisplayName: "[i:SpiritReforged/ButterflyStaff] (Santuários de Borboletas) Máximo"
				Tooltip: O número máximo de santuários de borboletas que podem ser colocados. Não é obrigatório colocar todos.
			}

			HeroChance: {
				DisplayName: "[i:SpiritReforged/HerosMemorialStatueItem] (Memorial de um Herói) Chance de surgimento"
				Tooltip: O denominador (1/x) da probabilidade de surgimento do Memorial de um Herói.
			}

			MaxStargrassCount: {
				DisplayName: "[i:SpiritReforged/StarPowder] (Grama Estelar) Quantidade de Gramados"
				Tooltip: O número máximo de manchas de grama estelar que podem ser colocadas. Não é obrigatório colocar todas, e é possível sobrepô-las.
			}

			ReforgedCaveWeight: {
				DisplayName: "[i:30] (Cavernas) Peso Personalizado"
				Tooltip: O peso para que uma caverna personalizada do Reforged surja no lugar de uma caverna de "montanha" do jogo base.
			}
		}
	}

	Ocean: {
		Name: Oceano
		Description: Controla aspectos específicos do oceano reformulado do Reforged.

		Presets: {
			KelpForest: {
				Name: "[i:SpiritReforged/Kelp] Floresta de Algas"
				Tooltip: Você consegue ver os campos de algas a partir da costa!
			}

			Volcanic: {
				Name: "[i:SpiritReforged/GravelItem] Vulcânico"
				Tooltip: Um oceano magmático e escarpado, praticamente sem flora.
			}
		}

		Members: {
			WaterChestCount: {
				DisplayName: "[i:1298] Limite dos Baús de Água"
				Tooltip: O número máximo de baús de água que podem ser colocados no oceano. Normalmente, não se colocam todos.
			}

			SunkenTreasureCount: {
				DisplayName: "[i:SpiritReforged/SunkenTreasure] Limite de Tesouros Naufragados"
				Tooltip: O número máximo de tesouros naufragados que podem ser colocados no oceano. Normalmente, não se colocam todos.
			}

			SandDepth: {
				DisplayName: "[i:169] Profundidade da Areia"
				Tooltip: A que profundidade a areia penetra no solo sob o oceano.
			}

			SandRange: {
				DisplayName: "[i:169] Campo de Areia"
				Tooltip: O limite superior do intervalo aleatório adicionado à profundidade da areia no oceano.
			}

			CoralLowChance: {
				DisplayName: "[i:275] Chance de Coral (Baixa)"
				Tooltip: O denominador (1/x) para a desova de corais nas camadas mais profundas do oceano.
			}

			CoralHighChance: {
				DisplayName: "[i:275] Chance de Coral (Alta)"
				Tooltip: O denominador (1/x) para a desova de corais na camada mais superficial do oceano.
			}

			DecorLowChance: {
				DisplayName: "[i:4090] Chance de Decoração (Baixa)"
				Tooltip: O denominador (1/x) para a geração de elementos decorativos nos níveis inferiores do oceano.
			}

			DecorHighChance: {
				DisplayName: "[i:4090] Chance de Decoração (Alta)"
				Tooltip: O denominador (1/x) para a geração de elementos decorativos no nível mais alto do oceano.
			}

			KelpChance: {
				DisplayName: "[i:SpiritReforged/Kelp] Chance de Algas"
				Tooltip: O denominador (1/x) para a geração de algas marinhas no oceano.
			}

			KelpMaxHeight: {
				DisplayName: "[i:SpiritReforged/Kelp] Altura das Algas"
				Tooltip: A altura máxima, em blocos, na qual as algas marinhas podem surgir.
			}

			GravelMultiplier: {
				DisplayName: "[i:SpiritReforged/GravelItem] Multiplicador de Cascalhos"
				Tooltip: O modificador do tamanho das manchas de cascalho oceânico (que inclui a pedra de magma).
			}

			Shape: {
				DisplayName: "[i:4460] Formato do Oceano"
				Tooltip: O formato que o Oceano terá.
			}
		}
	}

