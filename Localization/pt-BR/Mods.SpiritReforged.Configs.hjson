ReforgedClientConfig: {
	DisplayName: Configurações do Cliente do Reforged

	ReflectionDetail: {
		Label: Detalhes nas reflexões
		Tooltip:
			'''
			Determina o nível de detalhe nos reflexos
			Quanto menor o valor, maior chance de um bom desempenho
			'''
	}

	AmbientSounds: {
		Label: Sons de Ambiente
		Tooltip: Novos sons em biomas específicos
	}

	ScreenshakeStrength: {
		Label: Tremor da tela
		Tooltip: ""
	}

	DisableWater: {
		Label: Desativa Visuais da Água
		Tooltip: Tira todas as alterações visuais da água do Reforged.
	}

	DebugEcotones: {
		Label: Debug de Ecotonos (com o WorldGen Previewer)
		Tooltip:
			'''
			PRECISA de WorldGen Previewer Mod.
			Permite que desenvolvedores e jogadores que utilizam o sistema Ecotone depurem problemas e compreendam os ecótonos com uma interface intuitiva.
			'''
	}

	Headers.Developer: Ferramentas de Desenvolvidor

	GlyphProjectileVisualEffects: {
		Label: Efeitos Visuais de Projéteis de Glifos
		Tooltip: ""
	}

	GlyphItemVisualEffects: {
		Label: Efeitos Visuais de Itens de Glifos
		Tooltip: ""
	}

	BannerJingle: {
		Label: Jingle de Bandeira
		Tooltip: Ativa o jingle para bandeiras, quando você consegue a sua primeira bandeira de uma certa criatura.
	}
}

ReforgedServerConfig: {
	DisplayName: Configuração do Servidor do Reforged

	VentCritters: {
		Label: Criaturas das Ventiladoras
		Tooltip:
			'''
			Ativa o surgimento de várias criaturas ao redor de ventiladoras hidrotermais
			Essas criaturas não interferem na taxa de surgimento de inimigos regulares
			No entanto, elas contribuem para o limite máximo de NPCs
			'''
	}

	MaxFloatingItemCount: {
		Label: Limite de Itens Flutuantes
		Tooltip: Determina quantos itens flutuantes podem estar ativos no mundo ao mesmo tempo.
	}

	AutoloadHeldProjectiles: {
		Label: Carregar automaticamente projéteis segurados
		Tooltip:
			'''
			Ativa um sistema que detecta a propriedade 'held projectile' ao carregar.
			Isso pode aumentar substancialmente os tempos de carregamento ou causar erros de carregamento se ativado em conjunto com outros mods,
			mas pode corrigir alguns problemas com certas mecânicas (como glifos) no jogo.
			Idealmente, outros mods utilizam o conjunto de projéteis nomeado 'HeldProjectile' (bool) para garantir uma compatibilidade estável.

			Isso não tem efeito algum sobre projéteis originais do vanilla ou do Reforged, que já estão definidos.
			'''
	}
}
