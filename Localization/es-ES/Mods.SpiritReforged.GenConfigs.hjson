			}
		}

		Presets: {
			Inhabited: {
				Name: "[i:498] Habitado"
				Tooltip: Hay señales de amigables exploradores por todo el Subterráneo... ¿qué les pasó?
			}

			Empty: {
				Name: "[i:1176] Vacío"
				Tooltip: ¿Hay alguien ahí afuera?
			}
