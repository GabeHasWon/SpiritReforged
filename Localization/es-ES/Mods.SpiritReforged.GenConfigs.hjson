	Caves: {
		Name: Cuevas
		Description: Controla las adiciones misceláneas de las Cuevas.

		Members: {
			SignChance: {
				DisplayName: "[i:171] Probabilidad de letrero (Casas)"
				Tooltip: El denominador (1/x) de la probabilidad de generar un letrero en las casas del subterráneo.
			}

			MannequinChance: {
				DisplayName: "[i:498] Probabilidad de maniquí (Casas)"
				Tooltip: El denominador (1/x) de la probabilidad de generar un maniquí en las casas del subterráneo.
			}

			LoomChance: {
				DisplayName: "[i:332] Probabilidad de telar (Casas)"
				Tooltip: El denominador (1/x) de la probabilidad de generar una "casa de telar" — lo que añade estandartes y un telar.
			}

			RareSignChance: {
				DisplayName: "[i:3617] Tasa de letrero poco común (Casas)"
				Tooltip: El denominador (1/x) de la probabilidad de generar un letrero subterráneo que contenga un mensaje poco común.
			}

			CartSpawnRate: {
				DisplayName: "[i:13] Tasa de vagoneta (Decoración)"
				Tooltip: El multiplicador de la cantidad máxima de vagonetas con mineral que se generan en el mundo.
			}

			BoomshroomRate: {
				DisplayName: "[i:SpiritReforged/BoomShroom] Tasa de champibomba (Decoración)"
				Tooltip: El multiplicador de la cantidad máxima de champibombas que se generan en el mundo.
			}

			CovesSpawnRate: {
				DisplayName: "[i:SpiritReforged/KoiTotem] Tasa de estanques"
				Tooltip:
					'''
					El multiplicador de la cantidad máxima de estanques de pesca que se generan en un mundo.
					Esto puede causar problemas con otros mods que generen estructuras.
					'''
			}

			NeonMossChance: {
				DisplayName: "[i:SpiritReforged/FlaskRadon] Probabilidad de musgo personalizado (Musgo de neón)"
				Tooltip: El denominador (x/6) de la probabilidad de generar musgo brillante personalizado de Reforged en lugar de uno vanilla.
			}

			StatueCountModifier: {
				DisplayName: "[i:SpiritReforged/WheezerStatueItem] Máximo de estatuas"
				Tooltip: El número máximo de estatuas de Reforged que se generan en el mundo.
			}

			StructuresMax: {
				DisplayName: "[i:SpiritReforged/PotteryWheelItem] Multiplicador (Alfarería)"
				Tooltip: El multiplicador de la cantidad de estructuras de alfarería que se generan en el mundo.
			}

			StructureScale: {
				DisplayName: "[i:SpiritReforged/PotteryWheelItem] Tamaño (Alfarería)"
				Tooltip: El tamaño aplicado a las estructuras de alfarería.
			}

			PotSpam: {
				DisplayName: "[i:SpiritReforged/PotteryWheelItem] Escala de alfarería (Alfarería)"
				Tooltip: Multiplicador de intentos para generar estructuras de alfarería en el mundo.
			}

			EnchantedWorkbenchChance: {
				DisplayName: "[i:SpiritReforged/EnchantedWorkbenchItem] Probabilidad de prensa de cera (Casas)"
				Tooltip: El denominador (1/x) de la probabilidad de generar una prensa de cera en las casas del subterráneo.
			}

			DisplayCaseChance: {
				DisplayName: "[i:SpiritReforged/DisplayCaseItem] Probabilidad de vitrina (Casas)"
				Tooltip: El denominador (1/x) de la probabilidad de generar una vitrina de cera en las casas del subterráneo.
			}

			MirrorRate: {
				DisplayName: "[i:SpiritReforged/EnchantedMirrorItem] Probabilidad de espejo del vinculo eterno (Decoración)"
