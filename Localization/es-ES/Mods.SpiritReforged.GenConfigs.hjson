	Desert: {
		Name: Desierto
		Description: Controla varios aspectos de la generación del Desierto de Reforged.

		Members: {
			PalmChanceLow: {
				DisplayName: "[i:2504] Probabilidad de palmera (Baja) (Oasis)"
				Tooltip: La probabilidad de generar una palmera después de que al menos una haya sido generada.
			}

			PalmChanceHigh: {
				DisplayName: "[i:2504] Probabilidad de palmera (Alta) (Oasis)"
				Tooltip: La probabilidad de generar una palmera antes de que al menos una haya sido generada.
			}

			CattailChance: {
				DisplayName: "[i:2996] Probabilidad de junco (Oasis)"
				Tooltip: La probabilidad de generar juncos en el oasis.
			}

			OasisPlantChance: {
				DisplayName: "[i:SpiritReforged/PineappleSeeds] Probabilidad de planta de oasis (Oasis)"
				Tooltip: La probabilidad de generar plantas en el oasis.
			}

			GlowflowerChance: {
				DisplayName: "[i:4045] Probabilidad de cempasúchil (Oasis)"
				Tooltip: La probabilidad de generar cempasúchil en el oasis.
			}

			PineappleChance: {
				DisplayName: "[i:4294] Probabilidad de piña (Oasis)"
				Tooltip: La probabilidad de generar piñas en el oasis.
			}

			SeaOatsChance: {
				DisplayName: "[i:SpiritReforged/WheatgrassSeedPouch] Probabilidad de avena de mar (Oasis)"
				Tooltip: La probabilidad de generar avena de mar. La avena de mar son plantas de grano con aspecto de hierba que crecen cerca del océano o en los oasis.
			}

			PoolWidth: {
				DisplayName: "[i:206] Ancho de la laguna (Oasis)"
				Tooltip: El rango del ancho de la laguna de un oasis subterráneo (en bloques).
			}

			PoolDepth: {
				DisplayName: "[i:206] Profundidad de la laguna (Oasis)"
				Tooltip: El rango de profundidad de la laguna de un oasis subterráneo (en bloques)..
			}

			MainNormalization: {
				DisplayName: "[i:1298] Normalización general (Oasis)"
				Tooltip:
					'''
					El factor con el cual se normaliza el conjunto de botín de objetos en general.
					Cuanto mayor sea este valor, serán más "uniformes" las probabilidades de obtener cualquier objeto.
					'''
			}

			ItemNormalization: {
				DisplayName: "[i:1298] Otra normalización (Oasis)"
				Tooltip:
					'''
					El factor con el cual se normaliza el conjunto de botín de objetos que no son principales.
					Cuanto mayor sea este valor, serán más "uniformes" las probabilidades de obtener cualquier objeto.
					'''
			}

			FossilCount: {
				DisplayName: "[i:SpiritReforged/PolishedAmberItem] Conteo de depósitos (Ámbar)"
				Tooltip: El número máximo de vetas de ámbar en el desierto subterráneo.
			}

			FossilMultiplier: {
				DisplayName: "[i:SpiritReforged/AmberFossilSafeItem] Multiplicador del mundo (Ámbar)"
				Tooltip: El multiplicador aplicado al número de vetas de ámbar según el tamaño del mundo.
			}

			PatchScale: {
				DisplayName: "[i:SpiritReforged/AmberFossilSafeItem] Tamaño del deposito (Ámbar)"
				Tooltip: El tamaño aplicado a una veta de ámbar.
			}

			RuinCount: {
				DisplayName: "[i:SpiritReforged/GildedRedSandstoneItem] Rango de generación (Ruinas)"
				Tooltip: El rango del número de ruinas del desierto subterráneo que se generan por Oasis.
			}

			LightRange: {
				DisplayName: "[i:SpiritReforged/SunDropper] Conteo de rayos de luz (Oasis)"
				Tooltip: El mínimo y el rango aleatorio adicional para la cantidad de rayos de luz en un oasis subterráneo.
			}

			ChestItemRange: {
				DisplayName: "[i:1298] Rango de objetos en cofre del oasis (Oasis)"
				Tooltip: El rango del número de objetos que pueden generarse en un cofre del oasis subterráneo.
			}

			RuinSegments: {
				DisplayName: "[i:SpiritReforged/RedSandstoneSlabItem] Rango de segmentos de las ruinas (Ruinas)"
				Tooltip: El rango del número de segmentos puede tener una ruina subterránea.
			}
		}

		Presets: {
			Overgrown: {
				Name: "[i:2996] Vegetación"
				Tooltip: Los oasis de este desierto son salvajes y están cubiertos de vegetación. ¿Cómo prosperan?.
			}

			Petrified: {
				Name: "[i:154] Petrificado"
				Tooltip: Las arenas albergan eones de ecosistemas fosilizados. ¿Podrás encontrarlos todos?.
			}

			Ruined: {
				Name: "[i:SpiritReforged/RedSandstoneSlabItem] Ruinoso"
				Tooltip: Una civilización antigua y olvidada prosperó bajo el desierto alguna vez. Sus ruinas permanecen.
			}
		}
	}
}

Enums: {
	OceanShape: {
		Default: {
			DisplayName: Vanilla
			Tooltip: La generación predeterminada del océano de Vanilla. Esto desactiva la mayoría de los cambios de Reforged.
		}

		SlantedSine: {
			DisplayName: Seno inclinado
			Tooltip: Una forma modificada del océano que se define por una onda seno inclinada.
		}

		Piecewise: {
			DisplayName: Por tramos
			Tooltip: La forma del océano se define por una función más compleja hecha por tramos.
		}

		Piecewise_M: {
			DisplayName: Por tramos (M)
			Tooltip: Una versión modificada de la función por tramos con pendientes ligeramente diferentes.
		}

		Piecewise_V: {
			DisplayName: Reforjada
			Tooltip: La versión finalizada del preajuste por tramos con varias modificaciones menores.
		}
	}
}
