	}

	Ziggurat: {
		Name: Zigurat
		Description: Controla aspectos del Zigurat y su contenido.

		Members: {
			UsedWidth: {
				DisplayName: "[i:SpiritReforged/RedSandstoneSlabItem] Ancho"
				Tooltip:
					'''
					El ancho usado para determinar el tamaño del Zigurat, no necesariamente el ancho real.
					Valores más altos que los predeterminados obligarán al Zigurat a generarse sobre una pirámide, ya que de otro modo podría no generarse en lo absoluto.
					'''
			}

			UsedHeight: {
				DisplayName: "[i:SpiritReforged/RedSandstoneSlabItem] Alto"
				Tooltip:
					'''
					La altura usada para determinar el tamaño del Zigurat, no necesariamente el alto real.
					Valores más altos que los predeterminados obligarán al Zigurat a generarse sobre una pirámide, ya que de otro modo podría no generarse en lo absoluto.
					'''
			}

			MaxInfections: {
				DisplayName: "[i:SpiritReforged/PaleHiveItem] Máximo de infecciones"
				Tooltip: El numero máximo de infecciones (nidos) por piso del Zigurat. Varía de 0 hasta el valor establecido.
			}

			PotChance: {
				DisplayName: "[i:SpiritReforged/BronzePotsItem] Probabilidad de vasija de bronce"
				Tooltip: La probabilidad de generar vasijas en el Zigurat.
			}

			LapisPotChance: {
				DisplayName: "[i:SpiritReforged/LapisPotsItem] Probabilidad de vasija de lapislázuli"
				Tooltip: La probabilidad de generar vasijas de lapislázuli en el Zigurat.
			}

			UncommonChance: {
				DisplayName: "[i:SpiritReforged/BiomePotsDesertItem] Probabilidad de vasija poco común"
				Tooltip: La probabilidad de generar vasijas poco comunes en el Zigurat.
			}

			MaxSpikeStripWidth: {
				DisplayName: "[i:SpiritReforged/NeedleTrapItem] Ancho máximo de franja de pinchos"
				Tooltip: El máximo ancho de las franjas de pinchos en el Zigurat.
			}

			SpikeStripChance: {
				DisplayName: "[i:SpiritReforged/NeedleTrapItem] Probabilidad de franja de pinchos"
				Tooltip: La probabilidad de generar franjas de pinchos en salas no especiales en el Zigurat.
			}

			SpecialRoomChance: {
				DisplayName: "[i:SpiritReforged/CarvedLapisWallItem] Probabilidad de salas especiales"
				Tooltip:
					'''
					La probabilidad de generar una sala del Zigurat como una sala especial; es decir, cualquiera de estas:
					Sala de biblioteca, sala de almacenamiento, sala de entierro
					'''
			}

			SkipRoomChance: {
				DisplayName: "[i:SpiritReforged/RedSandstoneBrickCrackedWallItem] Probabilidad de omitir sala"
				Tooltip: La probabilidad de omitir una sala del Zigurat en lugar de construirla.
			}

			ChestNormalization: {
				DisplayName: "[i:SpiritReforged/LapisChestItem] Normalización de cofres"
				Tooltip:
					'''
					El factor con el cual se normaliza el conjunto de botín de los cofres.
					Cuanto mayor sea este valor, serán más “uniformes” las probabilidades de obtener cualquier objeto.
					'''
			}

			DresserNormalization: {
				DisplayName: "[i:SpiritReforged/LapisDresserItem] Normalización de aparador"
				Tooltip:
					'''
					El factor con el cual se normaliza el conjunto de botín de los aparadores.
					Cuanto mayor sea este valor, serán más “uniformes” las probabilidades de obtener cualquier objeto.
					'''
			}

			AncientBannerChance: {
				DisplayName: "[i:SpiritReforged/AncientBannerItem] Probabilidad de estandarte ancestral"
