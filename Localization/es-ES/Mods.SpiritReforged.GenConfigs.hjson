UI: {
	Min: Todo al mínimo
	MinDescription:
		'''
		Configura todos los parámetros en los valores que reduzcan al máximo la generación 
		Así que un valor como “máxima profundidad del cañón” se establecerá a su mínimo
		pero un valor para “probabilidad de árbol (1/x)” se establecerá en su máximo
		'''
	Max: Todo al máximo
	MaxDescription:
		'''
		Configura todos los parámetros en los valores que maximicen la generación 
		Por lo que un valor como “máximo de árboles” se establecerá a su máximo 
		pero un valor como “probabilidad de árbol (1/x)” se establecerá en su mínimo
		'''
	Preset: Preajuste:
	NoPresets: (Sin preajustes)
	None: Ninguno
	Reset: Restablecer
	ResetAll: Restablecer todos
	Prior: Priorizar:
	Next: Siguiente:
	True: Activado
	False: Desactivado
	Total: "{0} en total"
	CustomPresetTooltip: ¡Este es un ajuste personalizado!
	Create: Guardar como preajuste customizado
	CantSave: (No puedes guardar un ajuste por defecto de Spirit)
	Load: Importar un ajuste personalizado
	LoadFolder: Importar una carpeta de ajustes personalizados
	HoverDescription: Configurar aspectos específicos de la generación de Spirit Reforged
	FailedToLoad: El preajuste no es para esta página. Página esperada: {0}
	ConfigNotice:
		'''
		[c/AAAAFF:Ranges] funciona estableciendo el mínimo junto a una adición aleatoria.
		El valor mostrado es el rango real usado en el juego al crear aleatoriamente.
		'''
	LoadError: Ha ocurrido un error al cargar un preajuste ({0}). Informa esto en el Discord (y revisa client.log):
	Duplicate: (Preajustes duplicados no añadidos - {0})
	From: de
}

Pages: {
	Savanna: {
		Name: "{$Ecotones.SavannaEcotone}"
		Description: Controla aspectos específicos de la generación del ecotono Sabana.

		Presets: {
			Domesticated: {
				Name: "[i:224] Domesticada"
				Tooltip: Una sabana más vivida, con más vasijas y menos fauna silvestre.
			}

			Infested: {
				Name: "[i:SpiritReforged/TermiteJar] Infestada"
				Tooltip: ¡Ups! ¡Termitas por todas partes! Los árboles pueden ser difíciles de encontrar.
			}

			Bumpy: {
				Name: "[i:SpiritReforged/Drypowder] Irregular"
				Tooltip: ¡Cuidado al caminar! Baches y colinas te esperan en esta salvaje sabana.
			}
		}

		Members: {
			OverSpawn: {
				DisplayName: "[i:50] Sobre la generación"
				Tooltip: Determina si la sabana debe generarse sobre el punto de aparición, al estilo de la semilla "savanna".
			}

			Steps: {
				DisplayName: "[i:SpiritReforged/DrywoodPlatformItem] Escalones"
				Tooltip: El número de escalones planos con los que se genera la sabana.
			}

			CampsiteChance: {
				DisplayName: "[i:SpiritReforged/SavannaCampfireItem] Probabilidad de campamento"
				Tooltip: El denominador (1/x) de la probabilidad de generar un campamento.
			}

			BaseTreeChance: {
				DisplayName: "[i:27] Probabilidad de árbol de acacia"
				Tooltip:
					'''
					El denominador (1/x) de la probabilidad de generar un árbol en determinados bloques.
					Esta probabilidad aumenta progresivamente hasta que se genera un árbol, y luego se reinicia.
					'''
			}

			PotChance: {
				DisplayName: "[i:SpiritReforged/CommonPotsSavannaItem] Probabilidad de vasija"
				Tooltip:
					'''
					El denominador (1/x) de la probabilidad de generar una vasija al decorar. 
					Esto no sobrescribe los bloques, por lo que un valor de uno NO generará una vasija en cada bloque.
					'''
			}

			TermiteChance: {
				DisplayName: "[i:SpiritReforged/TermiteJar] Probabilidad de termita"
				Tooltip: El denominador (1/x) de la probabilidad de generar un montículo de termitas al decorar.
			}
		}
	}

	SaltFlats: {
		Name: "{$Ecotones.SaltFlatsEcotone}"
		Description: Controla aspectos específicos de la generación del ecotono Salar.

		Presets: {
			SunkenRuin: {
				Name: "[i:SpiritReforged/CobbledBrickItem] Ruinas hundidas"
				Tooltip: Las ruinas de una civilización antigua han sido lavadas y desgastadas con el tiempo.
			}

			BlankCanvas: {
				Name: "[i:SpiritReforged/GlidingItem] Lienzo en blanco"
				Tooltip: Un reflejo vacío e infinito yace ante ti.
			}

			Dessicated: {
				Name: "[i:1274] Desecado"
				Tooltip: No hay ni una gota de agua a la vista. Todos los árboles se han marchitado.
			}
		}

		Members: {
			OverSpawn: {
				DisplayName: "[i:50] Sobre la generación"
				Tooltip: Determina si el salar debe generarse sobre el punto de aparición, al estilo de la semilla "salt".
			}

			RuinQty: {
				DisplayName: "[i:SpiritReforged/CalmingBellItem] Ruinas del salar"
				Tooltip: El límite superior para las ruinas generadas en el salar. Es posible que no se generen todas.
			}

			LakeRadius: {
				DisplayName: "[i:206] Radio de lagos"
				Tooltip: El radio de los lagos del salar. Los radios más grandes corresponden a lagos más grandes.
			}

			CaveRadius: {
				DisplayName: "[i:SpiritReforged/SaltWallItem] Radio de cavernas"
				Tooltip: El radio de las cavernas del salar. Los radios más grandes corresponden a cavernas más grandes.
			}

			MaxSteps: {
				DisplayName: "[i:SpiritReforged/SaltBlockReflectiveItem] Pasos máximos"
				Tooltip: El número máximo de llanuras reflectantes dentro de un salar.
			}

			StupaChance: {
				DisplayName: "[i:SpiritReforged/StoneStupasItem] Probabilidad de estupa"
				Tooltip:
					'''
					El denominador (1/x) de la probabilidad de generar una piedra de estupa al decorar. 
					Esto no sobrescribe los bloques, por lo que un valor de uno NO generará una estupa en cada bloque.
					'''
			}

			TreeChance: {
				DisplayName: "[i:27] Probabilidad de árbol muerto"
				Tooltip:
					'''
					El denominador (1/x) de la probabilidad de generar un árbol en determinados bloques.
					Esta probabilidad aumenta progresivamente hasta que se genere un árbol, y luego se reinicia.
					'''
			}
		}
	}

	Surface: {
		Name: Superficie
		Description: Controla aspectos específicos de las adiciones y ediciones de Reforged para la Superficie.

		Presets: {
			Whimsical: {
				Name: "[i:SpiritReforged/MidnightApple] Fantasioso"
				Tooltip: Cuevas gigantes y frondosas, colinas de césped de estrellas y tranquilos campos de trigo... ¿qué podría salir mal?
			}

			Treacherous: {
				Name: "[i:SpiritReforged/LeatherBackpack] Traicionero"
				Tooltip: Vastas gargantas pueden salpicar el paisaje. ¡No mires hacia abajo!
			}
		}

		Members: {
			HalfWidth: {
				DisplayName: "[i:133] Semiancho del cañón"
				Tooltip: Controla el semiancho del montículo de un cañón, si está lo suficientemente cerca de la superficie.
			}

			MaxDepth: {
				DisplayName: "[i:133] Máxima profundidad del cañón"
				Tooltip: Controla la profundidad máxima de un cañón.
			}

			SizeMultiplier: {
				DisplayName: "[i:747] Multiplicador de tamaño (Karst)"
				Tooltip: Multiplicador en el tamaño de todas las operaciones de excavación para los karsts (cuevas frondosas).
			}

			FieldSize: {
				DisplayName: "[i:SpiritReforged/BotanistHat] Longitud del campo de trigo"
				Tooltip: Controla la anchura del campo de trigo del espantapájaros
			}

			ButterflyCountMax: {
				DisplayName: "[i:SpiritReforged/ButterflyStaff] Máximo de Santuarios de Mariposas"
				Tooltip: El número máximo de santuarios de mariposas que pueden generarse. Es posible que no se generen todos.
			}

			HeroChance: {
				DisplayName: "[i:SpiritReforged/HerosMemorialStatueItem] Probabilidad de el memorial del héroe"
				Tooltip: El denominador (1/x) de la probabilidad de generar el memorial del héroe.
			}

			MaxStargrassCount: {
				DisplayName: "[i:SpiritReforged/StarPowder] Conteo de parches (Césped de estrellas)"
				Tooltip: El número máximo de parches de césped de estrellas que pueden generarse. Es posible que no se generen todos, o que se superpongan.
			}

			ReforgedCaveWeight: {
				DisplayName: "[i:30] Peso de cuevas personalizadas"
				Tooltip: El peso para que una cueva personalizada de Reforged aparezca en lugar de una cueva 'montaña' vanilla.
			}
		}
	}

	Ocean: {
		Name: Océano
		Description: Controla aspectos específicos del Océano renovado de Reforged.

		Presets: {
			KelpForest: {
				Name: "[i:SpiritReforged/Kelp] Bosque de algas"
				Tooltip: ¡Puedes ver los campos de algas desde la orilla!
			}

			Volcanic: {
				Name: "[i:SpiritReforged/GravelItem] Volcánico"
				Tooltip: Un océano escarpado y magmático con apenas flora.
			}
		}

		Members: {
			WaterChestCount: {
				DisplayName: "[i:1298] Máximo de cofres de agua"
				Tooltip: El número máximo de cofres de agua que pueden generarse en el océano. Es posible que no se generen todos.
			}

			SunkenTreasureCount: {
				DisplayName: "[i:SpiritReforged/SunkenTreasure] Máximo de tesoros hundidos"
				Tooltip: El número máximo de tesoros hundidos que pueden generarse en el océano. Es posible que no se generen todos.
			}

			SandDepth: {
				DisplayName: "[i:169] Profundidad de la arena"
				Tooltip: Qué tan profundo llega la arena bajo el océano.
			}

			SandRange: {
				DisplayName: "[i:169] Rango de la arena"
				Tooltip: El límite superior en el océano para el rango aleatorio de profundidad de la arena.
			}

			CoralLowChance: {
				DisplayName: "[i:275] Probabilidad de coral (Bajo)"
				Tooltip: El denominador (1/x) de la probabilidad de generar coral en los niveles inferiores del océano.
			}

			CoralHighChance: {
				DisplayName: "[i:275] Probabilidad de coral (Alto)"
				Tooltip: El denominador (1/x) de la probabilidad de generar coral en los niveles superiores del océano.
			}

			DecorLowChance: {
				DisplayName: "[i:4090] Probabilidad de decoración (Bajo)"
				Tooltip: El denominador (1/x) de la probabilidad de generar decoración en los niveles inferiores del océano.
			}

			DecorHighChance: {
				DisplayName: "[i:4090] Probabilidad de decoración (Alto)"
				Tooltip: El denominador (1/x) de la probabilidad de generar decoración en los niveles superiores del océano.
			}

			KelpChance: {
				DisplayName: "[i:SpiritReforged/Kelp] Probabilidad de alga"
				Tooltip: El denominador (1/x) de la probabilidad de generar algas en el océano.
			}

			KelpMaxHeight: {
				DisplayName: "[i:SpiritReforged/Kelp] Altura de las algas"
				Tooltip: La altura máxima en bloques para generar algas.
			}

			GravelMultiplier: {
				DisplayName: "[i:SpiritReforged/GravelItem] Multiplicador de tamaño (Grava)"
				Tooltip: El modificador en el tamaño de los parches de grava oceánica (incluye la piedra magmática).
			}

			Shape: {
				DisplayName: "[i:4460] Forma del océano"
				Tooltip: La forma que toma el océano
			}
		}
	}

