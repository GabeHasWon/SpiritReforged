ReforgedClientConfig: {
	DisplayName: 魂灵新魄客户端配置

	ReflectionDetail: {
		Label: 反射细节
		Tooltip:
			'''
			决定所有反射的细节
			值越高意味着细节越多，相应的性能成本也越高
			'''
	}

	AmbientSounds: {
		Label: 环境音
		Tooltip: 在特定生物群系中播放环境音
	}

	ScreenshakeStrength: {
		Label: 屏幕震动强度
		Tooltip: 控制魂灵新魄屏幕震动的强度。
	}

	DisableWater: {
		Label: 禁用水体视觉效果
		Tooltip: 禁用魂灵新魄水体的视觉效果。
	}

	DebugEcotones: {
		Label: 过渡带调试（WorldGen Previewer）
		Tooltip:
			'''
			需要WorldGen Previewer（世界生成预览）
			允许开发者和玩家通过一个实用的叠加界面使用过渡带系统，来调试问题并理解过渡带。
			'''
	}

	Headers.Developer: 开发者工具

	GlyphProjectileVisualEffects: {
		// Label: Glyph Projectile Effects
		// Tooltip: Determines if projectiles with glyphs should create visual effects
	}

	GlyphItemVisualEffects: {
		// Label: Glyph Item Effects
		// Tooltip: Determines if items with glyphs should have shaders and visual effects when dropped in world
	}

	BannerJingle: {
		// Label: Banner Jingle
		// Tooltip: Enables the banner jingle, which plays when the first banner for an NPC type is spawned.
	}
}

ReforgedServerConfig: {
	DisplayName: 魂灵新魄服务器配置

	VentCritters: {
		Label: 热液喷口生态系统
		Tooltip:
			'''
			启用后，允许小动物在热液喷口附近生成
			这些生物不会干扰敌人的正常生成
			然而，它们确实对最大NPC数量限制有所贡献
			'''
	}

	MaxFloatingItemCount: {
		Label: 漂浮物上限
		Tooltip: 影响一个世界内同时可以有多少漂浮物。
	}

	AutoloadHeldProjectiles: {
		// Label: Autoload Held Projectiles
		/* Tooltip:
			'''
			Enables a system that automatically detects 'held projectiles' during loading.
			This may substantially increase load times or cause load errors if enabled with other mods,
			but may fix some issues with certain mechanics (such as glyphs) in-game.
			Ideally, other mods use the HeldProjectile named projectile set (bool) for stable compatibility.

			This has NO effect on vanilla or Reforged projectiles, which are already set.
			''' */
	}
}
