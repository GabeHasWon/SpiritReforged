ReforgedClientConfig: {
	DisplayName: 魂灵新魄客户端配置

	ReflectionDetail: {
		Label: 反射细节
		Tooltip:
			'''
			决定所有反射的细节
			值越高意味着细节越多，相应的性能成本也越高
			'''
	}

	AmbientSounds: {
		Label: 环境音
		Tooltip: 在特定生物群系中播放环境音
	}

	ScreenshakeStrength: {
		Label: 屏幕震动强度
		Tooltip: 控制魂灵新魄屏幕震动的强度。
	}

	DisableWater: {
		Label: 禁用水体视觉效果
		Tooltip: 禁用魂灵新魄水体的视觉效果。
	}

	DebugEcotones: {
		Label: 过渡带调试（WorldGen Previewer）
		Tooltip:
			'''
			需要WorldGen Previewer（世界生成预览）
			允许开发者和玩家通过一个实用的叠加界面使用过渡带系统，来调试问题并理解过渡带。
			'''
	}

	Headers.Developer: 开发者工具

	GlyphProjectileVisualEffects: {
		Label: 雕文弹幕效果
		Tooltip: 决定带有雕文的弹幕是否应创建视觉效果
	}

	GlyphItemVisualEffects: {
		Label: 雕文物品效果
		Tooltip: 决定带有雕文的物品掉落在世界上时是否有着色器和视觉效果
	}

	BannerJingle: {
		Label: 旗帜叮当声
		Tooltip: 启用旗帜叮当声，在生成某个NPC类型的第一个旗帜时播放。
	}
}

ReforgedServerConfig: {
	DisplayName: 魂灵新魄服务器配置

	VentCritters: {
		Label: 热液喷口生态系统
		Tooltip:
			'''
			启用后，允许小动物在热液喷口附近生成
			这些生物不会干扰敌人的正常生成
			然而，它们确实对最大NPC数量限制有所贡献
			'''
	}

	MaxFloatingItemCount: {
		Label: 漂浮物上限
		Tooltip: 影响一个世界内同时可以有多少漂浮物。
	}

	AutoloadHeldProjectiles: {
		Label: 自动加载手持弹幕
		Tooltip:
			'''
			启用一个在加载时自动探测“手持弹幕”的系统。
			如果与其他模组一同启用，可能会显著增加加载时间或导致加载错误，
			但可能会修复特定机制（如雕文）在游戏中的一些问题。
			理想情况下，其他模组为了稳定的兼容性会使用名为弹幕集的HeldProjectile（布尔值）。

			这对原版或魂灵新魄的弹幕无效，因为它们已经设置好了。
			'''
	}
}
